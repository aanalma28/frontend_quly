{
	"name": "frontend-quly",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"engines": {
		"node": "^24.22.1"
	},
	"scripts": {
		"dev": "vite dev",
		"build": "vite build",
		"test": "node --test tests/*.test.mjs",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
